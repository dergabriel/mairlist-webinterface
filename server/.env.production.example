# Produktions-Konfiguration für Windows Server Deploy (135.181.214.103:8841)
# Kopieren nach .env und Werte anpassen. .env NICHT committen.

# Port, auf dem der Node-Prozess (API + Frontend) lauscht
PORT=8841

# Datenquelle für die Library-Routen (Items/Folders/Playlists/Audio):
#   "sqlite" - direkter Zugriff auf die mAirList .mldb-Datei (better-sqlite3)
#   "api"    - Zugriff über die mAirListDB Server REST-API (siehe API_DB_*
#              unten); Vermeidet SQLite-Lock-Konflikte mit mAirList, deckt
#              aber noch nicht alle Funktionen ab (z.B. Storages-Verwaltung,
#              Suche, Dashboard) - dort gibt es im api-Modus einen Fehler.
#   "mock"   - In-Memory-Testdaten, kein echter mAirList-Zugriff
# Die Benutzerverwaltung/Login läuft unabhängig davon immer über die
# bestehende Logik (unbeeinflusst von DATA_SOURCE).
DATA_SOURCE=sqlite

# Pfad zur mAirList SQLite-DB auf dem Server (nur für DATA_SOURCE=sqlite)
DB_PATH=C:\mAirList\Data\mairlist.mldb

# mAirListDB Server REST-API (nur für DATA_SOURCE=api)
# API_DB_BASE_URL=http://localhost:8840
# API_DB_USER=
# API_DB_PASSWORD=
# API_DB_STATION=1

# Basisverzeichnis für Uploads (z.B. Jingles, Cover-Art)
UPLOAD_BASE_DIR=C:\mAirList\Data\Uploads

# Passwort für den initialen Admin-Account des Webinterfaces (nur beim
# ersten Start relevant, wenn noch kein Benutzer existiert). Wenn leer, wird
# ein zufälliges Passwort generiert und einmalig im Server-Log ausgegeben.
INITIAL_ADMIN_PASSWORD=

# Erlaubte Origins für CORS, kommagetrennt.
# Bei Single-Origin-Deploy (API + Frontend auf gleichem Port) reicht die eigene URL.
ALLOWED_ORIGINS=http://135.181.214.103:8841
